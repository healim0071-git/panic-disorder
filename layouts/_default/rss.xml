{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title | default site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <atom:link href="{{ .Permalink }}rss.xml" rel="self" type="application/rss+xml" />
    <description>{{ .Description | default site.Params.hugoblox.identity.description | plainify }}</description>
    <generator>해아림한의원 공황장애 클리닉</generator>
    <language>ko</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <image>
      <url>https://healim-panic.com/media/sharing.jpg</url>
      <title>{{ .Title | default site.Title }}</title>
      <link>{{ .Permalink }}</link>
    </image>
    {{- /* 1. 주요 공개 페이지 RSS 아이템 */ -}}
    {{- range site.Pages -}}
      {{- if and (not .IsHome) (ne .Params.private true) (not (in .RelPermalink "/admin/")) (not (in .RelPermalink "/login/")) (not (in .RelPermalink "/register/")) (not (in .RelPermalink "/site_join_type_choice/")) (not (in .RelPermalink "/tags/")) (not (in .RelPermalink "/categories/")) (not (in .RelPermalink "/authors/")) -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ if not .Date.IsZero }}{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ else }}{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ end }}</pubDate>
      <author>healim@healim.com (해아림한의원)</author>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Description | default .Summary | plainify }}</description>
      <category>공황장애 진료</category>
    </item>
      {{- end -}}
    {{- end -}}

    {{- /* 2. 자동 발행 의료 칼럼 (Columns) */ -}}
    {{- with hugo.Data.healim_community_hub -}}
      {{- range .columns -}}
    <item>
      <title>{{ .title | plainify }}</title>
      <link>https://healim-panic.com/community/#columns-{{ .id }}</link>
      <guid isPermaLink="true">https://healim-panic.com/community/#columns-{{ .id }}</guid>
      <pubDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <author>healim@healim.com (해아림한의원)</author>
      <category>{{ .category | default "공황장애 치료 칼럼" | plainify }}</category>
      <description>{{ .summary | default .title | plainify }}</description>
    </item>
      {{- end -}}

      {{- /* 3. 자동 발행 FAQ (자주 묻는 질문) */ -}}
      {{- range .faq -}}
    <item>
      <title>{{ .title | plainify }}</title>
      <link>https://healim-panic.com/community/#faq-{{ .id }}</link>
      <guid isPermaLink="true">https://healim-panic.com/community/#faq-{{ .id }}</guid>
      <pubDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <author>healim@healim.com (해아림한의원)</author>
      <category>{{ .category | default "공황장애 FAQ" | plainify }}</category>
      <description>{{ .summary | default .title | plainify }}</description>
    </item>
      {{- end -}}
    {{- end -}}
  </channel>
</rss>
